import java.util.Scanner;

public class Ejercico1_Calificaciones {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);
        
        // Acumulador y contadores requeridos
        double sumaNotas = 0;
        int contadorAprobados = 0;   // Excelente y Aprobado (>= 7)
        int contadorReprobados = 0;  // Supletorio y Reprobado (< 7)
        
        System.out.println("--- REGISTRO DE CALIFICACIONES ---");
        
        // Estructura 'for' para solicitar exactamente 5 notas válidas
        for (int i = 1; i <= 5; i++) {
            System.out.print("Ingrese la calificacion " + i + " (0 a 10): ");
            double nota = teclado.nextDouble();
            
            // Validación de la nota (Requisito obligatorio)
            if (nota < 0 || nota > 10) {
                System.out.println("¡Error! La nota debe estar entre 0 y 10. Intente de nuevo.");
                i--; // Decrementamos el índice para repetir la entrada actual
                continue;
            }
            
            // Acumular la nota válida para el promedio final
            sumaNotas += nota;
            
            // Clasificación con estructura 'if-else'
            if (nota >= 9 && nota <= 10) {
                System.out.println("-> Clasificacion: Excelente");
                contadorAprobados++;
            } else if (nota >= 7 && nota < 9) {
                System.out.println("-> Clasificacion: Aprobado");
                contadorAprobados++;
            } else if (nota >= 5 && nota < 7) {
                System.out.println("-> Clasificacion: Supletorio");
                contadorReprobados++; // Va a supletorio, por lo tanto no aprobó directamente
            } else {
                System.out.println("-> Clasificacion: Reprobado");
                contadorReprobados++;
            }
            System.out.println("-----------------------------------");
        }
        
        // Cálculo del promedio
        double promedio = sumaNotas / 5;
        
        // Mostrar resultados finales
        System.out.println("\n=== REPORTES FINALES ===");
        System.out.printf("Promedio general: %.2f\n", promedio);
        System.out.println("Cantidad de aprobados: " + contadorAprobados);
        System.out.println("Cantidad de reprobados (incluye supletorios): " + contadorReprobados);
        
        teclado.close();
    }
}
